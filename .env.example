# Copy to .env and replace every "replace-with-..." value. .env is git-ignored.
# APP_ENV=production refuses to start the API with placeholder secrets or insecure cookies.
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (Compose publishes it on 127.0.0.1:POSTGRES_PORT)
POSTGRES_DB=opsai
POSTGRES_USER=opsai
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Used when running the API, worker, or Alembic on the host; keep in sync with the values above.
DATABASE_URL=postgresql+psycopg://opsai:replace-with-local-database-password@localhost:5432/opsai

# Redis (Compose publishes it on 127.0.0.1:REDIS_PORT)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=opsai:document-processing

# API. API_PORT and WEB_PORT are the host ports Compose publishes.
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Behind a reverse proxy, list its address so per-client rate limits see real client IPs.
FORWARDED_ALLOW_IPS=127.0.0.1,::1
# At least 32 random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=30
AUTH_COOKIE_SECURE=false

# Web. Inlined into the browser bundle at build time; rebuild the web image after changing it.
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Documents and retrieval. STORAGE_DIR applies to host development only; containers use a volume.
STORAGE_DIR=./storage
MAX_FILE_SIZE=10485760
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash
EMBEDDING_DIMENSION=384
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.35

# Chat. The local deterministic provider needs no API key.
CHAT_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
